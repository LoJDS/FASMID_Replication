# FASMID replication repo - allow-list.
# Everything is ignored unless re-included below, so new outputs, logs and
# backups never get picked up by accident. Model outputs (csv, png, pickles,
# RDS) and the CMA-ES histories are regenerated by the scripts, not versioned.
/*

# --- Repo metadata -----------------------------------------------------------
!/.gitignore
!/.gitattributes
!/README.md
!/environment.yml
!/requirements.txt

# --- Main model ----------------------------------------------------------------
!/Model-Solver VersionA.py
!/Model-Solver VersionB3.py
!/SolveandStore.py
!/Module.py
!/Store.py
!/NGFS_Scenarios.py
!/Intensity_Schedule_Generator.py
!/Carbon_Price_Schedule_Generator.py
!/Emission_Schedule_Generator.py
!/Data/
/Data/*.orig
# Output folder, kept empty so a fresh clone can write to it
!/Results/
/Results/*
!/Results/.gitkeep

# --- Applications and experiments ---------------------------------------------
!/Experiments.py
!/Policy_Experiments.py
!/Bottleneck.py
!/SolveandStore_kappa.py
!/Validation/
/Validation/*
!/Validation/CrossCorr.py
!/Validation/Model_Plain.py
!/Validation/Data/
!/Validation/Figure/
/Validation/Figure/*
!/Validation/Figure/.gitkeep
!/Data Reproduction/

# --- Calibration (base + calibrated parameter files, CMA-ES workflow) -------
!/Calibration/
/Calibration/*
!/Calibration/Calibration_Files/
/Calibration/Calibration_Files/*/
!/Calibration/Configs/
!/Calibration/Results/
!/Calibrator/
!/CMAESCalibrator/
/CMAESCalibrator/CMAESCalibrator/
/CMAESCalibrator/tests/_tmp/
!/apply_best_calibrations.py
!/cmaes_config.example.yaml

# --- Sensitivity workflow (LHS -> scenario replay -> Sobol / OT -> tables) --
!/Sensitivity_Analysis/
/Sensitivity_Analysis/*
!/Sensitivity_Analysis/LatHyperREMIND2022_Parallel2.py
!/Sensitivity_Analysis/ScenarioRun_Parallel.py
!/Sensitivity_Analysis/Sobol.py
!/Sensitivity_Analysis/Sobol_Plot.py
!/Sensitivity_Analysis/Sensitivity_Table.py
!/Sensitivity_Analysis/Sensitivity_OT.R
!/Sensitivity_Analysis/Results/
/Sensitivity_Analysis/Results/*
!/Sensitivity_Analysis/Results/.gitkeep
!/Sensitivity_Analysis/Sensitivity_Analysis/
/Sensitivity_Analysis/Sensitivity_Analysis/*
!/Sensitivity_Analysis/Sensitivity_Analysis/Module.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Store.py
!/Sensitivity_Analysis/Sensitivity_Analysis/NGFS_Scenarios.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Intensity_Schedule_Generator.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Carbon_Price_Schedule_Generator.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Emission_Schedule_Generator.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Sensitivity_Model.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Model_Initialise.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Model_Run.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Sensitivity_Calibration_New.py
!/Sensitivity_Analysis/Sensitivity_Analysis/Sobol_Resources.py
!/Sensitivity_Analysis/Sensitivity_Analysis/NGFS 2021 Vintage.xlsx
!/Sensitivity_Analysis/Sensitivity_Analysis/NGFS 2022 Vintage.xlsx
!/Sensitivity_Analysis/Sensitivity_Analysis/NGFS 2024 Vintage.xlsx

# --- Figures and tables (R) ----------------------------------------------------
!/Viz/
/Viz/*
!/Viz/*.R
/Viz/_where_tmp.R

# --- Global excludes (apply inside every re-included folder) ------------------
__pycache__/
*.pyc
*.csv
*.png
*.pdf
*.pkl
*.pickle
*.RDS
*.RData
*.Rhistory
*.log
*.out
*.err
Backup*/
